// sha2.nx: SHA-256, SHA-384 and SHA-512 (FIPS 180-4).
//
// `import nxtls.sha2` then:
//
//     let d = sha2.sha256("abc")              // 32 bytes
//     var h = sha2.Hasher.new(sha2.Kind.Sha384)
//     h.update(first)
//     h.update(second)
//     let d2 = h.finish()                     // 48 bytes
//
// A hasher is a plain value: copying it snapshots the running hash, which
// is how a TLS transcript is hashed at several points while it grows.
//
// The compression functions are adds, rotates and xors over fixed-length
// loops. Nothing branches on or indexes by the bytes being hashed, only by
// their length, so the same code serves public transcripts and secret keys
// (HMAC, HKDF).

import tables
import std.bytes

/// Which SHA-2 function.
pub enum Kind {
    Sha256,
    Sha384,
    Sha512,
}

/// Digest length in bytes.
pub fn digest_len(k: Kind) -> usize {
    return match k {
        .Sha256 => 32,
        .Sha384 => 48,
        .Sha512 => 64,
    }
}

/// Block length in bytes; HMAC pads keys to it.
pub fn block_len(k: Kind) -> usize {
    return match k {
        .Sha256 => 64,
        .Sha384 => 128,
        .Sha512 => 128,
    }
}

fn rotr32(x: u32, n: u32) -> u32 {
    return (x >> n) | (x << (32 - n))
}

fn rotr64(x: u64, n: u64) -> u64 {
    return (x >> n) | (x << (64 - n))
}

// ------------------------------------------------------------------ SHA-256

fn compress256(h: *mut [8]u32, block: []u8) {
    var w: [64]u32 = undefined
    for t in 0..16 {
        let j = t * 4
        w[t] = ((block[j] as u32) << 24) | ((block[j + 1] as u32) << 16) | ((block[j + 2] as u32) << 8) | (block[j + 3] as u32)
    }
    for t in 16..64 {
        let s0 = rotr32(w[t - 15], 7) ^ rotr32(w[t - 15], 18) ^ (w[t - 15] >> 3)
        let s1 = rotr32(w[t - 2], 17) ^ rotr32(w[t - 2], 19) ^ (w[t - 2] >> 10)
        w[t] = w[t - 16] +% s0 +% w[t - 7] +% s1
    }
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    var e = h[4]
    var f = h[5]
    var g = h[6]
    var hh = h[7]
    for t in 0..64 {
        let sum1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
        let ch = (e & f) ^ (~e & g)
        let t1 = hh +% sum1 +% ch +% tables.K256[t] +% w[t]
        let sum0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
        let maj = (a & b) ^ (a & c) ^ (b & c)
        let t2 = sum0 +% maj
        hh = g
        g = f
        f = e
        e = d +% t1
        d = c
        c = b
        b = a
        a = t1 +% t2
    }
    h[0] = h[0] +% a
    h[1] = h[1] +% b
    h[2] = h[2] +% c
    h[3] = h[3] +% d
    h[4] = h[4] +% e
    h[5] = h[5] +% f
    h[6] = h[6] +% g
    h[7] = h[7] +% hh
}

/// A running SHA-256.
pub struct Sha256 {
    h: [8]u32
    block: [64]u8
    used: usize
    total: u64
}

impl Sha256 {
    pub fn new() -> Sha256 {
        return Sha256{ .h = tables.IV256, .block = undefined, .used = 0, .total = 0 }
    }

    fn push(self: *mut Self, b: u8) {
        self.block[self.used] = b
        self.used += 1
        if self.used == 64 {
            compress256(&mut self.h, self.block[..])
            self.used = 0
        }
    }

    pub fn update(self: *mut Self, data: []u8) {
        self.total +%= data.len as u64
        var i: usize = 0
        while i < data.len {
            if self.used == 0 and data.len - i >= 64 {
                compress256(&mut self.h, data[i..i + 64])
                i += 64
            } else {
                self.push(data[i])
                i += 1
            }
        }
    }

    /// The digest; the hasher is spent afterwards.
    pub fn finish(self: *mut Self) -> String {
        let bits = self.total *% 8
        self.push(0x80)
        while self.used != 56 {
            self.push(0)
        }
        for i in 0..8 {
            self.push(@truncate(u8, bits >> ((56 - 8 * i) as u64)))
        }
        var out = String.with_capacity(32)
        for v in self.h {
            out.push_byte(@truncate(u8, v >> 24))
            out.push_byte(@truncate(u8, v >> 16))
            out.push_byte(@truncate(u8, v >> 8))
            out.push_byte(@truncate(u8, v))
        }
        return out
    }
}

// ------------------------------------------------------------------ SHA-512

fn compress512(h: *mut [8]u64, block: []u8) {
    var w: [80]u64 = undefined
    for t in 0..16 {
        var v: u64 = 0
        for k in 0..8 {
            v = (v << 8) | (block[t * 8 + k] as u64)
        }
        w[t] = v
    }
    for t in 16..80 {
        let s0 = rotr64(w[t - 15], 1) ^ rotr64(w[t - 15], 8) ^ (w[t - 15] >> 7)
        let s1 = rotr64(w[t - 2], 19) ^ rotr64(w[t - 2], 61) ^ (w[t - 2] >> 6)
        w[t] = w[t - 16] +% s0 +% w[t - 7] +% s1
    }
    var a = h[0]
    var b = h[1]
    var c = h[2]
    var d = h[3]
    var e = h[4]
    var f = h[5]
    var g = h[6]
    var hh = h[7]
    for t in 0..80 {
        let sum1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41)
        let ch = (e & f) ^ (~e & g)
        let t1 = hh +% sum1 +% ch +% tables.K512[t] +% w[t]
        let sum0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39)
        let maj = (a & b) ^ (a & c) ^ (b & c)
        let t2 = sum0 +% maj
        hh = g
        g = f
        f = e
        e = d +% t1
        d = c
        c = b
        b = a
        a = t1 +% t2
    }
    h[0] = h[0] +% a
    h[1] = h[1] +% b
    h[2] = h[2] +% c
    h[3] = h[3] +% d
    h[4] = h[4] +% e
    h[5] = h[5] +% f
    h[6] = h[6] +% g
    h[7] = h[7] +% hh
}

/// A running SHA-512, or SHA-384 (the same function with other initial
/// values and a shorter digest).
pub struct Sha512 {
    h: [8]u64
    block: [128]u8
    used: usize
    total: u64
    out_len: usize
}

impl Sha512 {
    pub fn new() -> Sha512 {
        return Sha512{ .h = tables.IV512, .block = undefined, .used = 0, .total = 0, .out_len = 64 }
    }

    pub fn new384() -> Sha512 {
        return Sha512{ .h = tables.IV384, .block = undefined, .used = 0, .total = 0, .out_len = 48 }
    }

    fn push(self: *mut Self, b: u8) {
        self.block[self.used] = b
        self.used += 1
        if self.used == 128 {
            compress512(&mut self.h, self.block[..])
            self.used = 0
        }
    }

    pub fn update(self: *mut Self, data: []u8) {
        self.total +%= data.len as u64
        var i: usize = 0
        while i < data.len {
            if self.used == 0 and data.len - i >= 128 {
                compress512(&mut self.h, data[i..i + 128])
                i += 128
            } else {
                self.push(data[i])
                i += 1
            }
        }
    }

    /// The digest; the hasher is spent afterwards.
    pub fn finish(self: *mut Self) -> String {
        // the length field is 128 bits; the high half holds what
        // `total * 8` carries out of 64 bits
        let high = self.total >> 61
        let bits = self.total *% 8
        self.push(0x80)
        while self.used != 112 {
            self.push(0)
        }
        for i in 0..8 {
            self.push(@truncate(u8, high >> ((56 - 8 * i) as u64)))
        }
        for i in 0..8 {
            self.push(@truncate(u8, bits >> ((56 - 8 * i) as u64)))
        }
        var out = String.with_capacity(64)
        for v in self.h {
            for k in 0..8 {
                out.push_byte(@truncate(u8, v >> ((56 - 8 * k) as u64)))
            }
        }
        if self.out_len < 64 {
            return String.from(out[0..self.out_len])
        }
        return out
    }
}

// ------------------------------------------------------------------ any of them

/// A running hash of any kind; HMAC and HKDF take one of these.
pub struct Hasher {
    kind: Kind
    s256: Sha256
    s512: Sha512
}

impl Hasher {
    pub fn new(kind: Kind) -> Hasher {
        let big = if kind == Kind.Sha384 { Sha512.new384() } else { Sha512.new() }
        return Hasher{ .kind = kind, .s256 = Sha256.new(), .s512 = big }
    }

    pub fn update(self: *mut Self, data: []u8) {
        if self.kind == Kind.Sha256 {
            self.s256.update(data)
        } else {
            self.s512.update(data)
        }
    }

    /// The digest, `digest_len(kind)` bytes; the hasher is spent afterwards.
    pub fn finish(self: *mut Self) -> String {
        if self.kind == Kind.Sha256 {
            return self.s256.finish()
        }
        return self.s512.finish()
    }
}

/// The digest of `data` in one call.
pub fn hash(kind: Kind, data: []u8) -> String {
    var h = Hasher.new(kind)
    h.update(data)
    return h.finish()
}

pub fn sha256(data: []u8) -> String {
    return hash(Kind.Sha256, data)
}

pub fn sha384(data: []u8) -> String {
    return hash(Kind.Sha384, data)
}

pub fn sha512(data: []u8) -> String {
    return hash(Kind.Sha512, data)
}

// ------------------------------------------------------------------ tests

/// `-` in a vector file is the empty string.
fn unhex(s: []u8) -> String {
    if s == "-" {
        return String.new()
    }
    return bytes.unhex(s) catch {
        panic("bad hex in a vector file")
    }
}

fn kind_named(name: []u8) -> Kind {
    if name == "sha256" {
        return Kind.Sha256
    }
    if name == "sha384" {
        return Kind.Sha384
    }
    expect_eq(name, "sha512")
    return Kind.Sha512
}

// byte i of test message n; tools/gen.py has the same generator
fn pattern(n: usize) -> String {
    var out = String.with_capacity(n)
    for i in 0..n {
        out.push_byte(@truncate(u8, i * 31 + n))
    }
    return out
}

test "known answers: FIPS 180-4 messages, every padding boundary, a million a's" {
    let text = @embedFile("../tests/vectors/sha2.txt")
    var count: usize = 0
    for line in text.lines() {
        if line.len == 0 or line[0] == '#' {
            continue
        }
        let f = line.split(" ")
        let kind = kind_named(f[0])
        var got = String.new()
        if f[1] == "million-a" {
            // fed in pieces that do not line up with the block size
            var h = Hasher.new(kind)
            let piece = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            for _ in 0..10000 {
                h.update(piece)
            }
            got = h.finish()
        } else if f[1].starts_with("pattern:") {
            let n = f[1][8..f[1].len].parse_int(usize) catch {
                panic("bad pattern length")
            }
            got = hash(kind, pattern(n))
        } else {
            got = hash(kind, unhex(f[1]))
        }
        expect_eq(bytes.hex(got), f[2])
        count += 1
    }
    expect_eq(count, 3 * (4 + 141 + 9 + 1))
}

test "streaming in odd pieces matches one call" {
    let msg = pattern(1000)
    for kind in [Kind.Sha256, Kind.Sha384, Kind.Sha512] {
        let whole = hash(kind, msg)
        let steps: [9]usize = [1, 3, 63, 64, 65, 127, 128, 129, 999]
        for step in steps {
            var h = Hasher.new(kind)
            var i: usize = 0
            while i < msg.len {
                let end = @min(i + step, msg.len)
                h.update(msg[i..end])
                i = end
            }
            expect_eq(h.finish(), whole)
        }
    }
}

test "a copied hasher is a snapshot" {
    var h = Hasher.new(Kind.Sha256)
    h.update("ab")
    var snap = h
    h.update("c")
    expect_eq(bytes.hex(h.finish()), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    snap.update("c")
    expect_eq(bytes.hex(snap.finish()), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    expect_eq(digest_len(Kind.Sha384), 48)
    expect_eq(sha384("").len, 48)
}
