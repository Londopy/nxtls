// entropy.nx: random bytes from the operating system, for keys, nonces
// and anything else an attacker must not guess.
//
// `import nxtls.entropy` then:
//
//     let key = try entropy.bytes(32)
//
// The bytes come from `random.secure` (Nexium 1.4), the operating system's
// secure generator: BCryptGenRandom on Windows, the getrandom system call
// on Linux (/dev/urandom on kernels too old for it), arc4random_buf on
// macOS and the BSDs. `bytes` fails with error.NoEntropy only where the
// system has no generator at all, and nothing weaker stands in for it.

/// `n` bytes from the operating system's generator; error.NoEntropy when
/// there is none.
pub fn bytes(n: usize) -> !String {
    var out = String.with_capacity(n)
    for _ in 0..n {
        out.push_byte(0)
    }
    random.secure(out[..]) catch {
        return error.NoEntropy
    }
    return out
}

/// Whether this system has a generator `bytes` can read.
pub fn available() -> bool {
    let probe = bytes(1) catch {
        return false
    }
    return probe.len == 1
}

// ------------------------------------------------------------------ tests

test "bytes from the system's generator, on every system" {
    let a = try bytes(32)
    let b = try bytes(32)
    expect_eq(a.len, 32)
    expect_eq(b.len, 32)
    expect(a != b)
    expect(available())
    expect_eq((try bytes(0)).len, 0)
    // more than one call's worth
    expect_eq((try bytes(100000)).len, 100000)
    // every value of a byte turns up in 64 KB (a stuck or constant source would not)
    let big = try bytes(65536)
    var seen = List(bool).new()
    for _ in 0..256 {
        seen.append(false)
    }
    for x in big {
        seen[x as usize] = true
    }
    for s in seen {
        expect(s)
    }
}
